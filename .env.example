# --------------------------------------------------
# AGILE WRITER TEST SUITE - ENVIRONMENT CONFIG
# --------------------------------------------------
# Copy this file to .env and fill in your credentials.

# Microsoft SSO credentials (required)
MS_EMAIL=your-email@smarter.codes
MS_PASSWORD=your-password-here
BASE_URL=https://app-v2-rc1-aw.smarter.codes

# Placeholder regex pattern
# Matches text like <some_TEXT> in the document
PLACEHOLDER_REGEX=<\s*([^<>]+?)\s*>

# Report metadata used by `npm run report`
TESTER_NAME="Aaron & Inayathulla"
TEST_ENV=QA
APP_URL=https://app-v2-rc1-aw.smarter.codes/signin

# ── SCC-592: GCS Storage Configuration ───────
# GCS_BUCKET=agilewriter-automation-testing-reports
# GCS_ENV_PREFIX=qa/
# GOOGLE_APPLICATION_CREDENTIALS=./your-service-account-key.json

# ─────────────────────────────────────────────
# HEALTH CHECK ENV VARS
# Run command: npx playwright test --project=health
# All vars below are required unless marked [optional]
# ─────────────────────────────────────────────
# ── CSR ──────────────────────────────────────
HEALTH_TEMPLATE_CSR=
HEALTH_TEMPLATE_FOLDER_CSR=
HEALTH_SOURCES_CSR=
HEALTH_SOURCE_FOLDER_CSR=
# ── ICF Full ──────────────────────────────────
HEALTH_TEMPLATE_ICF_FULL=
HEALTH_TEMPLATE_FOLDER_ICF_FULL=
HEALTH_SOURCES_ICF_FULL=
HEALTH_SOURCE_FOLDER_ICF_FULL=
# ── ICF Trimmed ───────────────────────────────
HEALTH_TEMPLATE_ICF_TRIMMED=
HEALTH_TEMPLATE_FOLDER_ICF_TRIMMED=
HEALTH_SOURCES_ICF_TRIMMED=
HEALTH_SOURCE_FOLDER_ICF_TRIMMED=
# ── Ideaya (ORG / IDE196-001) ─────────────────
# sourceSelectionMode: folder — sourceNestedFolders is required,
# not optional. Absence causes silent wrong source selection.
# allowMissingSourcesSoft: true — runner will not hard-fail if a
# folder exists but is empty. This is intentional behavior.
HEALTH_TEMPLATE_IDEAYA=
HEALTH_TEMPLATE_FOLDER_IDEAYA=
HEALTH_SOURCE_FILE_IDEAYA=
HEALTH_SOURCE_PARENT_FOLDER_IDEAYA=
HEALTH_SOURCE_NESTED_FOLDERS_IDEAYA=
HEALTH_OUTPUT_PREFIX_IDEAYA=        # [optional] default: Ideaya_CSR
HEALTH_EXPECTED_MINUTES_IDEAYA=     # [optional] default: 30
# ── Ideaya Preflight (PRODTEST / IDE196-009) ──
# stopBeforeTraining: true — this config never triggers a training run.
# HEALTH_CLIENT_IDEAYA_PREFLIGHT is required — without it the runner
# targets ORG instead of PRODTEST, causing a silent wrong-client run.
HEALTH_TEMPLATE_IDEAYA_PREFLIGHT=
HEALTH_TEMPLATE_FOLDER_IDEAYA_PREFLIGHT=
HEALTH_PARENT_FOLDER_IDEAYA_PREFLIGHT=
HEALTH_CLIENT_IDEAYA_PREFLIGHT=
# ── Ideaya PRODTEST CSR Full Run (IDE196-009) ─
# RESERVED — Issue 1A (not yet implemented)
# Config key will be: ideayaProdtestCsr
# These vars will be wired in a future PR.
HEALTH_TEMPLATE_IDEAYA_PRODTEST_CSR=
HEALTH_TEMPLATE_FOLDER_IDEAYA_PRODTEST_CSR=
HEALTH_TEMPLATE_PARENT_FOLDER_IDEAYA_PRODTEST_CSR=
HEALTH_SOURCES_IDEAYA_PRODTEST_CSR=
HEALTH_SOURCE_PARENT_FOLDER_IDEAYA_PRODTEST_CSR=
HEALTH_OUTPUT_PREFIX_IDEAYA_PRODTEST_CSR=   # [optional]
HEALTH_EXPECTED_MINUTES_IDEAYA_PRODTEST_CSR= # [optional] expected: 30
# ── M264 ──────────────────────────────────────
HEALTH_TEMPLATE_M264=
HEALTH_TEMPLATE_FOLDER_M264=
HEALTH_SOURCES_M264=
HEALTH_SOURCE_FOLDER_M264=
