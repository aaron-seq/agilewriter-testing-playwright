# ──────────────────────────────────────────────
# AGILE WRITER TEST SUITE — ENVIRONMENT CONFIG
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your credentials.

# Microsoft SSO credentials (required)
MS_EMAIL=your-email@smarter.codes
MS_PASSWORD=your-password-here
BASE_URL=https://app-v2-rc1-aw.smarter.codes

# Placeholder regex pattern
# Matches text like <some_TEXT> in the document
PLACEHOLDER_REGEX = <\s*([^<>]+?)\s*>

# ──────────────────────────────────────────────
# HEALTH REPORT CONFIGURATION
# ──────────────────────────────────────────────
# These variables control which documents the health report scripts
# will use for training. Update these BEFORE running a health report.
#
# HOW IT WORKS:
#   1. Edit the values below with the client-provided document names
#   2. Run: npx playwright test tests/health_ICF_trimmed.spec.ts --headed
#   3. After the test, run: npm run report
#   4. Find the PDF at: reports/AgileWriter_Report.pdf

# Template document name (exactly as it appears in the file picker)
HEALTH_TEMPLATE=ICF_SET0_TRIMMED.docx

# Folder containing the template (expands after search in file picker)
HEALTH_TEMPLATE_FOLDER=QA Testing

# Source document names (comma-separated if multiple)
HEALTH_SOURCES=Protocol Example (28Sep2023).docx

# Folder containing source documents
HEALTH_SOURCE_FOLDER=QA Testing

# Prefix for the output filename (timestamp is added automatically)
HEALTH_OUTPUT_PREFIX=ICF_Trimmed

# ──────────────────────────────────────────────
# EXAMPLE CONFIGS FOR EACH DOCUMENT TYPE
# ──────────────────────────────────────────────
#
# ICF Trimmed (~5 min training):
#   HEALTH_TEMPLATE=ICF_SET0_TRIMMED.docx
#   HEALTH_TEMPLATE_FOLDER=QA Testing
#   HEALTH_SOURCES=Protocol Example (28Sep2023).docx
#   HEALTH_SOURCE_FOLDER=QA Testing
#   HEALTH_OUTPUT_PREFIX=ICF_Trimmed
#
# ICF Full (~15 min training):
#   HEALTH_TEMPLATE=ICF_SET0.docx
#   HEALTH_TEMPLATE_FOLDER=QA Testing
#   HEALTH_SOURCES=Protocol Example (28Sep2023).docx
#   HEALTH_SOURCE_FOLDER=QA Testing
#   HEALTH_OUTPUT_PREFIX=ICF_Full
#
# CSR (~20 min training):
#   HEALTH_TEMPLATE=CSR_Template_20FEB2026.docx
#   HEALTH_TEMPLATE_FOLDER=CSR
#   HEALTH_SOURCES=Mock_CSR _Tables_30Oct25.rtf,Mock_CSR_Protocol.docx,Mock_CSR Key messages_with_heading.docx
#   HEALTH_SOURCE_FOLDER=CSR
#   HEALTH_OUTPUT_PREFIX=CSR_Test
#
# M264 (~25 min training):
#   HEALTH_TEMPLATE=2.6.4 Template_Test.docx
#   HEALTH_TEMPLATE_FOLDER=M264
#   HEALTH_SOURCES=Absorption_PK Study in Dog.docx,Metabolism_Report.docx,ABC-123_Summary and Conclusion.docx,DDI_Cyp_Report.docx,ABC-123_Method of Analysis.docx,Distribution_Blood Partitioning.docx,Absorption_PK Study in Rat.docx
#   HEALTH_SOURCE_FOLDER=M264
#   HEALTH_OUTPUT_PREFIX=M264_Test