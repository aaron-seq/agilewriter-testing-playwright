# --------------------------------------------------
# AGILE WRITER TEST SUITE - ENVIRONMENT CONFIG
# --------------------------------------------------
# Copy this file to .env and fill in your credentials.

# Microsoft SSO credentials (required)
MS_EMAIL=your-email@smarter.codes
MS_PASSWORD=your-password-here
BASE_URL=https://app-v2-rc1-aw.smarter.codes

# Placeholder regex pattern
# Matches text like <some_TEXT> in the document
PLACEHOLDER_REGEX=<\s*([^<>]+?)\s*>

# Report metadata used by `npm run report`
TESTER_NAME="Aaron & Inayathulla"
TEST_ENV=QA
APP_URL=https://app-v2-rc1-aw.smarter.codes/signin

# --------------------------------------------------
# HEALTH REPORT CONFIGURATION
# --------------------------------------------------
# These variables control which documents the health report scripts
# will use for training. Update the document family you want to run
# before starting a health report.
#
# HOW IT WORKS:
#   1. Edit the namespaced values for the document type you want to run
#   2. Run: npx playwright test tests/health_ICF_trimmed.spec.ts --headed
#   3. After the test, run: npm run report
#   4. Find the Word report at: reports/AgileWriter_Validation_Report.docx

# --------------------------------------------------
# ICF Trimmed (~5 min training)
# --------------------------------------------------
HEALTH_TEMPLATE_ICF_TRIMMED=ICF_SET0_TRIMMED.docx
HEALTH_TEMPLATE_FOLDER_ICF_TRIMMED=QA Testing
HEALTH_SOURCES_ICF_TRIMMED=Protocol Example (28Sep2023).docx
HEALTH_SOURCE_FOLDER_ICF_TRIMMED=QA Testing
HEALTH_OUTPUT_PREFIX_ICF_TRIMMED=ICF_Trimmed

# --------------------------------------------------
# ICF Full (~15 min training)
# --------------------------------------------------
HEALTH_TEMPLATE_ICF_FULL=ICF_SET0.docx
HEALTH_TEMPLATE_FOLDER_ICF_FULL=QA Testing
HEALTH_SOURCES_ICF_FULL=Protocol Example (28Sep2023).docx
HEALTH_SOURCE_FOLDER_ICF_FULL=QA Testing
HEALTH_OUTPUT_PREFIX_ICF_FULL=ICF_Full

# --------------------------------------------------
# CSR (~20 min training)
# --------------------------------------------------
HEALTH_TEMPLATE_CSR=CSR_Template_20FEB2026.docx
HEALTH_TEMPLATE_FOLDER_CSR=CSR
HEALTH_SOURCES_CSR=Mock_CSR _Tables_30Oct25.rtf,Mock_CSR_Protocol.docx,Mock_CSR Key messages_with_heading.docx
HEALTH_SOURCE_FOLDER_CSR=CSR
HEALTH_OUTPUT_PREFIX_CSR=CSR_Test

# --------------------------------------------------
# M264 (~25 min training)
# --------------------------------------------------
HEALTH_TEMPLATE_M264=2.6.4 Template_Test.docx
HEALTH_TEMPLATE_FOLDER_M264=M264
HEALTH_SOURCES_M264=Absorption_PK Study in Dog.docx,Metabolism_Report.docx,ABC-123_Summary and Conclusion.docx,DDI_Cyp_Report.docx,ABC-123_Method of Analysis.docx,Distribution_Blood Partitioning.docx,Absorption_PK Study in Rat.docx
HEALTH_SOURCE_FOLDER_M264=M264
HEALTH_OUTPUT_PREFIX_M264=M264_Test

# --------------------------------------------------
# EXAMPLE NOTES
# --------------------------------------------------
#
# ICF Trimmed (~5 min training):
#   Uses HEALTH_TEMPLATE_ICF_TRIMMED and related ICF_TRIMMED keys above
#
# ICF Full (~15 min training):
#   Uses HEALTH_TEMPLATE_ICF_FULL and related ICF_FULL keys above
#
# CSR (~20 min training):
#   Uses HEALTH_TEMPLATE_CSR and related CSR keys above
#
# M264 (~25 min training):
#   Uses HEALTH_TEMPLATE_M264 and related M264 keys above
