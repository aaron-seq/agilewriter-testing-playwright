.env
sc-nlx-*.json
*service-account*.json
*gcp*.json
*.credentials.json
# Auth state — machine-specific, must be regenerated on cloud
playwright/.auth/
# Generated output — mount as volumes instead
sessions/
reports/
# Git history
.git/
# Dev tooling
.vscode/
*.log
# Python benchmarking — not needed in container
benchmarking-automation/
# OS files
.DS_Store
Thumbs.db

